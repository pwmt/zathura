/* Index mode colors */

#zathura .indexmode {
  background-color: @index-bg@;
}

#zathura .indexmode row {
  color: @index-fg@;
  background-color: @index-bg@;
}

#zathura .indexmode row:selected {
  color: @index-active-fg@;
  background-color: @index-active-bg@;
}

/* gtk4 draws a focus ring on the focused/selected row, like the inputbar entry */
#zathura .indexmode row:focus,
#zathura .indexmode row:focus-visible,
#zathura .indexmode row:selected {
  outline: none;
  box-shadow: none;
}

/* Scrollbar */
#zathura scrolledwindow scrollbar {
  background-color: @scrollbar-bg@;
}

#zathura scrolledwindow scrollbar > slider {
  background-color: @scrollbar-fg@;
}

