#zathura > overlay {
  color: @default-fg@;
  background-color: @default-bg@;
  background-image: none;
  font-family: @font-family@;
  font-size: @font-size@;
  font-weight: @font-weight@;
  font-style: @font-style@;
}

/* Inputbar */
#zathura entry.inputbar {
  background-color: @inputbar-bg@;
  box-shadow: none;
  outline: none;
}

/* gtk4 draws a focus ring on the entry that the generic .inputbar rule cannot override */
#zathura entry.inputbar:focus-within {
  box-shadow: none;
  outline: none;
}

#zathura .inputbar {
  color: @inputbar-fg@;
  background-color: @inputbar-bg@;
  box-shadow: none; /* maybe use some user-definable color here */
}

#zathura entry.inputbar text {
  caret-color: @inputbar-fg@;
  -gtk-secondary-caret-color: @inputbar-fg@;
}

/* Completion entries and groups */
#zathura .completion,
#zathura .completion-box {
  color: @completion-fg@;
  background-color: @completion-bg@;
}

#zathura .completion-box > row {
  padding: 0;
  margin: 0;
  border: none;
  outline: none;
  background: none;
  box-shadow: none;
}

#zathura .completion {
  padding: 1px;
}

#zathura .completion-box > row:selected .completion {
  color: @completion-highlight-fg@;
  background-color: @completion-highlight-bg@;
}

#zathura .completion-group {
  color: @completion-group-fg@;
  background-color: @completion-group-bg@;
  padding: 2px 4px;
}

/* Statusbar */
#zathura .statusbar {
  color: @statusbar-fg@;
  background-color: @statusbar-bg@;
}

#zathura .statusbar-item {
  padding: 0px 1pt;
}

/* Notification area */

#zathura .notification {
  color: @notification-fg@;
  background-color: @notification-bg@;
}

#zathura .notification-error {
  color: @notification-error-fg@;
  background-color: @notification-error-bg@;
}

#zathura .notification-warning {
  color: @notification-warning-fg@;
  background-color: @notification-warning-bg@;
}

/* Padding of the bottom box */
#zathura .bottom_box {
  border-style: none;
  margin: 0px;
  padding: @bottombox-padding1@px @bottombox-padding2@px @bottombox-padding3@px
    @bottombox-padding4@px;
}

#zathura scrolledwindow undershoot.top,
#zathura scrolledwindow undershoot.top:backdrop,
#zathura scrolledwindow undershoot.bottom,
#zathura scrolledwindow undershoot.bottom:backdrop,
#zathura scrolledwindow undershoot.left,
#zathura scrolledwindow undershoot.left:backdrop,
#zathura scrolledwindow undershoot.right,
#zathura scrolledwindow undershoot.right:backdrop,
#zathura scrolledwindow overshoot.top,
#zathura scrolledwindow overshoot.top:backdrop,
#zathura scrolledwindow overshoot.bottom,
#zathura scrolledwindow overshoot.bottom:backdrop,
#zathura scrolledwindow overshoot.left,
#zathura scrolledwindow overshoot.left:backdrop,
#zathura scrolledwindow overshoot.right,
#zathura scrolledwindow overshoot.right:backdrop {
  background-image: none;
}
